{
	"name": "nestjs-backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"dev": "cross-env NODE_ENV=development rspack dev",
		"start:dev": "npm run dev",
		"build": "cross-env NODE_ENV=production rspack build",
		"start:prod": "cross-env NODE_ENV=production node dist/main.cjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"db:migrate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
		"db:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
		"db:seed": "ts-node src/database/seeds/seed.ts"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/jwt": "^12.0.3",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-express": "^12.0.1",
		"bcrypt": "^6.0.0",
		"mysql2": "^3.24.6",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.0",
		"@nestjs/mau": "^0.2.6",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@nestjs/typeorm": "^12.0.2",
		"@rspack/cli": "^2.2.9",
		"@rspack/core": "^2.2.9",
		"@rspack/dev-server": "^2.2.2",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^7.0.0",
		"@types/webpack-node-externals": "^3.0.4",
		"@vitest/coverage-v8": "^4.1.2",
		"cross-env": "^10.1.0",
		"oxlint": "^1.58.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.4.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"run-script-webpack-plugin": "^0.2.3",
